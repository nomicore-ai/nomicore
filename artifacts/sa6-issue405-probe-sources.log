import type {
  NamespaceRuntime,
  NamespaceRuntimeReadDataOptions,
  NamespaceRuntimeReadDataBudgetResult,
} from '@nomicore/namespace-runtime';
import type { ReadLogicalValueAtPathOptions } from '@nomicore/doc-runtime';
import type { NamespaceLease } from '@nomicore/namespace-registry';

type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends <T>() => T extends B ? 1 : 2 ? true : false;
type AssertTrue<T extends true> = T;

// ───────── 能力缺口（HEAD 期望报错；实现后须干净） ─────────

// G1: 目标 options 闭合形状含 maxBytes
export const g1: NamespaceRuntimeReadDataOptions = { maxBytes: 1024 };

// G2: runtime 调用点（字面量 options）
declare const runtime: NamespaceRuntime;
export const g2 = runtime.readData([], { maxBytes: 1024 });

// G3: registry lease 调用点（租约 options 别名跟随）
declare const lease: NamespaceLease;
export const g3 = lease.readData([], { maxBytes: 1024 });

// G4: 结果联合的失败分支判别码
export const g4: Extract<NamespaceRuntimeReadDataBudgetResult, { ok: false }>['code'] = 'READ_BUDGET_EXCEEDED';

// G5: 失败分支载荷窄化（measuredBytes 只在 READ_BUDGET_EXCEEDED 成员上在场）
export function g5(r: NamespaceRuntimeReadDataBudgetResult): number | null {
  if (!r.ok && r.code === 'READ_BUDGET_EXCEEDED') return r.measuredBytes;
  return null;
}

// ───────── 恒绿控制（负控/回归锁） ─────────

// C1: 既有两键在闭合形状内（恒绿）
export const c1: NamespaceRuntimeReadDataOptions = { depth: 1, maxChildrenPerNode: 2 };

// C2: 未知键保持编译红（@ts-expect-error 必须被使用，否则 TS2578）
// @ts-expect-error 未知键不在闭合形状内
export const c2: NamespaceRuntimeReadDataOptions = { nope: 1 };

// C3: doc-runtime options 仍恰两键（ADR 0031 §4：doc-runtime 零改动、下传两键）
type _docRuntimeTwoKeys = AssertTrue<Equal<keyof ReadLogicalValueAtPathOptions, 'depth' | 'maxChildrenPerNode'>>;

// C4: 既有成功成员四键形状不变（回归锚）
type _okShape = AssertTrue<
  Equal<
    Extract<NamespaceRuntimeReadDataBudgetResult, { ok: true }>,
    { ok: true; value: unknown; schema: string | null; truncated: boolean }
  >
>;

// C5: 三键复合 options（实现后合法；HEAD 因 maxBytes 报 TS2353）
export const c5: NamespaceRuntimeReadDataOptions = { depth: 1, maxChildrenPerNode: 2, maxBytes: 358 };

