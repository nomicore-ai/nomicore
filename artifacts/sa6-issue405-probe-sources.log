/**
 * SA6 issue #405 临时闸门/断言判据探针（诊断用；非测试文件、不入 vitest 收集、收尾删除）。
 *
 * 内容：
 *  G0 **参考闸门**（reference gate；只组合公共 API，非生产实现）：按 ADR 0031 §2/§3 语义给
 *     `readData` 加「总量 ≤ maxBytes 收 / > maxBytes 零交付拒」——证明验收断言**可满足**
 *     （不是不可能任务），并给出目标实现的预期结果形状。
 *  A  **验收断言组原型**（契约 §12 判据）：同一断言函数分别对
 *     (a) HEAD 真实 runtime（期望：目标断言红、失败原因 = 能力缺口）
 *     (b) 参考闸门（期望：全绿）
 *     求值——红点归因可判定（READ_OPTIONS_INVALID / 未知键 ≠ 断言装置错误）。
 *  L  **lease 透传判据**（registry lease ≡ 同 doc 直调 runtime；released 短路优先）。
 *  X  **敌意 options 负控**（accessor / descriptor trap / 非 enumerable 键）。
 *
 * 运行：NODE_OPTIONS=--conditions=nomicore-source pnpm exec tsx packages/namespace-registry/.sa6-405-probe/probe-gate.ts
 */
import * as Y from 'yjs';
import { createMemoryPersistence } from '@nomicore/persistence';
import type { DocHandle, DocPersistence, PersistenceScheduler, User } from '@nomicore/persistence';
import type {
  NamespaceRuntime,
  NamespaceRuntimeReadDataBudgetResult as BudgetResult,
} from '@nomicore/namespace-runtime';
import type { NamespaceLease } from '@nomicore/namespace-registry';
import { createNamespaceRegistryForTesting, createRegistryTestScheduler } from '@nomicore/namespace-registry/testing';
import { createNamespaceRuntimeWithSeam } from '../../namespace-runtime/src/runtime.js';

const SCHEDULER: PersistenceScheduler = {
  setTimeout: (callback, delayMs) => globalThis.setTimeout(callback, delayMs),
  clearTimeout: (handle) => globalThis.clearTimeout(handle as ReturnType<typeof globalThis.setTimeout>),
};

const TXT_405 = `
type Meta = YMap<{
  /** 备注内容 */
  content: YLeaf<string>;
  /** 附加计数 */
  extra: YLeaf<number>;
}>;
type ROOT = YMap<{
  /** 页面标题 */
  title: YLeaf<string>;
  count: YLeaf<number>;
  /** 元数据 */
  meta: Meta;
  /** 标签组 */
  tags: YLeaf<string>[];
  /** 可选昵称 */
  nick?: YLeaf<string>;
}>;
`.trim();

const ENV_405 = { lang: 'vfsl', version: 1, id: 'ns-405', text: TXT_405 } as const;
const OWNER: User = { userId: 'u-405' };

function buildDoc(raw: boolean): Y.Doc {
  const doc = new Y.Doc();
  const sc = doc.getMap('SCHEMA');
  for (const [k, v] of Object.entries(ENV_405)) sc.set(k, v);
  const meta = doc.getMap('META');
  meta.set('docId', 'ns-405');
  meta.set('createdAt', 1_700_000_000_000);
  const root = doc.getMap('ROOT');
  root.set('title', '你好，世界');
  root.set('count', 3);
  const m = new Y.Map<unknown>();
  m.set('content', '备注说明');
  m.set('extra', 7);
  root.set('meta', m);
  const tags = new Y.Array<string>();
  tags.push(['甲', '乙', '丙', '丁', '戊']);
  root.set('tags', tags);
  if (raw) root.set('rogue', 'x'.repeat(100));
  return doc;
}

const utf8 = (text: string): number => Buffer.byteLength(text, 'utf8');

type AnyRead = BudgetResult | { ok: true; value: unknown; schema: string | null; truncated: boolean };
interface Budgeted {
  readonly depth?: number;
  readonly maxChildrenPerNode?: number;
}
type CallFace = (path: readonly (string | number)[], options?: Budgeted & { readonly maxBytes?: number }) => AnyRead;

/** 参考闸门（非生产实现；ADR 0031 §2/§3 语义的组合层模型）。 */
function withByteBudget(runtime: NamespaceRuntime, path: readonly (string | number)[], options: Budgeted & { readonly maxBytes?: number }): AnyRead {
  const { maxBytes, ...rest } = options;
  const twoKeys = rest as Budgeted;
  const delivered = Object.keys(twoKeys).length === 0 ? runtime.readData(path) : runtime.readData(path, twoKeys);
  if (delivered.ok !== true) return delivered as BudgetResult;
  if (maxBytes === undefined) return delivered;
  const valueJson = JSON.stringify(delivered.value);
  const valueBytes = valueJson === undefined ? 0 : utf8(valueJson);
  const schemaBytes = delivered.schema === null ? 0 : utf8(delivered.schema);
  const measuredBytes = valueBytes + schemaBytes;
  if (measuredBytes <= maxBytes) return delivered;
  return {
    ok: false,
    code: 'READ_BUDGET_EXCEEDED',
    path: [...path],
    measuredBytes,
    message: `READ_BUDGET_EXCEEDED: 交付总量 ${String(measuredBytes)} 字节 > maxBytes ${String(maxBytes)}`,
  } as BudgetResult;
}

interface CheckResult {
  readonly name: string;
  readonly ok: boolean;
  readonly detail: string;
}

const out: string[] = [];
const line = (s = ''): void => {
  out.push(s);
};

const eq = (a: unknown, b: unknown): boolean => JSON.stringify(a) === JSON.stringify(b);
const fiveKeys = (keys: readonly string[]): boolean => eq([...keys].sort(), ['code', 'measuredBytes', 'message', 'ok', 'path']);

function oracleTotal(oracleCall: CallFace, path: readonly (string | number)[], options?: Budgeted): number {
  const r = oracleCall(path, options);
  if (r.ok !== true) throw new Error(`断言装置前提失败：oracle 读应成功（${JSON.stringify(r)}）`);
  const json = JSON.stringify(r.value);
  return (json === undefined ? 0 : utf8(json)) + (r.schema === null ? 0 : utf8(r.schema));
}

/** 严格档断言组（T1–T9；锚值 = probe-runtime.log P2/P3 实测）。 */
function strictAssertions(call: CallFace, oracle: CallFace): CheckResult[] {
  const R: CheckResult[] = [];
  const push = (name: string, ok: boolean, detail: string): void => {
    R.push({ name, ok, detail });
  };
  {
    const anchored = oracle([]);
    const budgeted = call([], { maxBytes: 358 });
    push(
      'T1 恰好等于 maxBytes=358 → 成功且与无 maxBytes 同参读逐字节一致',
      budgeted.ok === true && eq(budgeted, anchored) && utf8(JSON.stringify(budgeted.value)) === 120 && (budgeted.schema === null ? 0 : utf8(budgeted.schema)) === 238,
      JSON.stringify(budgeted).slice(0, 110),
    );
  }
  {
    const r = call([], { maxBytes: 357 });
    push(
      'T2 maxBytes=357 → READ_BUDGET_EXCEEDED、measuredBytes=358、恰五键 {ok,code,path,measuredBytes,message}',
      r.ok === false && r.code === 'READ_BUDGET_EXCEEDED' && r.measuredBytes === 358 && fiveKeys(Object.keys(r)) && r.message.length > 0,
      JSON.stringify(r).slice(0, 150),
    );
  }
  {
    const anchored = oracle([]);
    const wide = call([], { maxBytes: 100000 });
    push('T3 宽预算 maxBytes=100000 → 成功面与无预算读全等（收/拒不塑形交付）', wide.ok === true && eq(wide, anchored), JSON.stringify(wide).slice(0, 110));
  }
  {
    const anchors: ReadonlyArray<{ name: string; path: readonly (string | number)[]; options?: Budgeted }> = [
      { name: 'R0 []', path: [] },
      { name: 'R1 [] depth1', path: [], options: { depth: 1 } },
      { name: 'R2 [] depth0', path: [], options: { depth: 0 } },
      { name: 'R3 [] width2', path: [], options: { maxChildrenPerNode: 2 } },
      { name: 'R4 [title]', path: ['title'] },
      { name: 'R5 [meta]', path: ['meta'] },
      { name: 'R6 [tags]', path: ['tags'] },
      { name: 'R7 [nick] 缺席', path: ['nick'] },
      { name: 'R11 [] depth1+width2', path: [], options: { depth: 1, maxChildrenPerNode: 2 } },
    ];
    const bad: string[] = [];
    for (const a of anchors) {
      const total = oracleTotal(oracle, a.path, a.options);
      const rejected = call(a.path, { ...(a.options ?? {}), maxBytes: total - 1 });
      const accepted = call(a.path, { ...(a.options ?? {}), maxBytes: total });
      const rejectedOk = rejected.ok === false && rejected.code === 'READ_BUDGET_EXCEEDED' && rejected.measuredBytes === total;
      const acceptedOk = accepted.ok === true;
      if (!rejectedOk || !acceptedOk) bad.push(`${a.name}(total=${String(total)}) rej=${JSON.stringify(rejected).slice(0, 80)} acc=${String(accepted.ok)}`);
    }
    push('T4 度量等式 property（9 锚；measuredBytes = utf8(json(value)) + utf8(schema)，含 ✂/头行/缺席）', bad.length === 0, bad.join(' | ') || 'all anchors hold');
  }
  {
    const invalidValues: ReadonlyArray<[string, unknown]> = [
      ['0', 0],
      ['-1', -1],
      ['1.5', 1.5],
      ['NaN', Number.NaN],
      ['Infinity', Number.POSITIVE_INFINITY],
      ['"100"', '100'],
      ['undefined 值在场', undefined],
    ];
    const bad: string[] = [];
    const messages: Record<string, string> = {};
    for (const [name, value] of invalidValues) {
      const r = call([], { maxBytes: value as number });
      if (r.ok !== false || r.code !== 'READ_OPTIONS_INVALID') bad.push(`${name} → ${JSON.stringify(r).slice(0, 90)}`);
      else messages[name] = r.message;
    }
    const unknownKey = call([], { nope: 1 } as never);
    const unknownMessage = unknownKey.ok === false && 'message' in unknownKey ? String((unknownKey as { message: string }).message) : '';
    const mentionMaxBytes = Object.values(messages).every((m) => m.includes('maxBytes'));
    const distinct = unknownMessage !== '' && Object.values(messages).every((m) => m !== unknownMessage);
    const validBoundary = call([], { maxBytes: 2 ** 53 - 1 });
    push(
      'T5 options 负控（0/-1/1.5/NaN/Inf/"100"/present-undefined → READ_OPTIONS_INVALID，message 标 maxBytes 域；有效域边界 2^53-1 收）',
      bad.length === 0 && mentionMaxBytes && distinct && validBoundary.ok === true,
      `bad=[${bad.join('; ')}] mention=${String(mentionMaxBytes)} distinct=${String(distinct)} validBoundary.ok=${String(validBoundary.ok)} msg0=${JSON.stringify(messages['0'] ?? null)} unknown=${JSON.stringify(unknownMessage)}`,
    );
  }
  {
    const total = oracleTotal(oracle, ['nick']);
    const rejected = call(['nick'], { maxBytes: total - 1 });
    const accepted = call(['nick'], { maxBytes: total });
    push(
      'T6 缺席目标 [nick]：投影文本照常计量（total=27；26 拒 / 27 收，value undefined 不豁免）',
      total === 27 && rejected.ok === false && rejected.code === 'READ_BUDGET_EXCEEDED' && rejected.measuredBytes === 27 && accepted.ok === true && accepted.value === undefined && accepted.schema !== null,
      `total=${String(total)} rej=${JSON.stringify(rejected).slice(0, 80)} acc.value=${String(accepted.value)}`,
    );
  }
  {
    const anchored = oracle([], { depth: 1 });
    const budgeted = call([], { depth: 1, maxBytes: 415 });
    push(
      'T7 {depth:1,maxBytes:415} → schema 与 {depth:1} 逐字节相同（头行不记 maxBytes、✂ 照常计入）',
      budgeted.ok === true && anchored.ok === true && budgeted.schema === anchored.schema && budgeted.truncated === true,
      `head=${JSON.stringify(budgeted.ok ? (budgeted.schema ?? '').split('\n')[0] : null)}`,
    );
  }
  {
    const r = call(['title', 0], { maxBytes: 1 });
    push('T8 值通道失败优先：PATH_NOT_ALLOWED 短路（不借预算码）', r.ok === false && r.code === 'PATH_NOT_ALLOWED', JSON.stringify(r).slice(0, 110));
  }
  {
    const r = call(['rogue'], { maxBytes: 1 });
    push('T9 [rogue] 严格档 total=0（schema null + 值缺席）→ maxBytes=1 成功（零总量 ≠ 超限）', r.ok === true && r.schema === null && r.value === undefined, JSON.stringify(r).slice(0, 110));
  }
  return R;
}

/** raw 档断言组（schema:null × 值侧单通道）。 */
function rawAssertions(call: CallFace, oracle: CallFace): CheckResult[] {
  const R: CheckResult[] = [];
  const total = oracleTotal(oracle, ['rogue']);
  const rejected = call(['rogue'], { maxBytes: total - 1 });
  const accepted = call(['rogue'], { maxBytes: total });
  R.push({
    name: `T10 schema:null × 值侧单通道（raw [rogue] total=${String(total)}）：${String(total - 1)} 拒 / ${String(total)} 收`,
    ok: total === 102 && rejected.ok === false && rejected.code === 'READ_BUDGET_EXCEEDED' && rejected.measuredBytes === 102 && accepted.ok === true && accepted.schema === null,
    detail: `rej=${JSON.stringify(rejected).slice(0, 100)} acc.schema=${String(accepted.schema)}`,
  });
  const bad: string[] = [];
  for (const anchor of [{ name: 'raw []', path: [] as const }, { name: 'raw [title]', path: ['title'] as const }]) {
    const t = oracleTotal(oracle, anchor.path);
    const rej = call(anchor.path, { maxBytes: t - 1 });
    if (!(rej.ok === false && rej.code === 'READ_BUDGET_EXCEEDED' && rej.measuredBytes === t)) bad.push(`${anchor.name}(total=${String(t)})`);
  }
  R.push({ name: 'T10b raw 档 property 附加锚（[] / [title]）', ok: bad.length === 0, detail: bad.join(', ') || 'ok' });
  return R;
}

function manualClock(): { now: () => number } {
  return { now: () => 1_700_000_123_456 };
}

let randomCounter = 0;
function deterministicRandomBytes(length: number): Uint8Array {
  randomCounter += 1;
  const hex = randomCounter.toString(16).padStart(32, '0');
  const outBytes = new Uint8Array(length);
  for (let i = 0; i < length; i += 1) outBytes[i] = Number.parseInt(hex.slice((i % 16) * 2, (i % 16) * 2 + 2), 16);
  return outBytes;
}

class StubHandle implements DocHandle {
  constructor(readonly owner: User, readonly docId: string, readonly doc: Y.Doc) {}
  getStatus(): 'ready' {
    return 'ready';
  }
  release(): Promise<void> {
    return Promise.resolve();
  }
}

class StubPersistence implements DocPersistence {
  constructor(private readonly handle: DocHandle) {}
  async createDoc(): Promise<DocHandle> {
    return this.handle;
  }
  async loadDoc(): Promise<DocHandle | null> {
    return this.handle;
  }
  async saveDoc(): Promise<void> {}
}

async function waitReady(runtime: NamespaceRuntime): Promise<void> {
  const deadline = Date.now() + 5_000;
  while (runtime.getStatus().schema.state !== 'ready') {
    if (Date.now() > deadline) throw new Error('装置前提失败：schema 未在 5s 内 ready');
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
}

async function makeRuntime(raw: boolean): Promise<NamespaceRuntime> {
  const persistence = createMemoryPersistence({ scheduler: SCHEDULER });
  const handle = await persistence.createDoc(OWNER, 'ns-405', buildDoc(raw));
  const runtime = createNamespaceRuntimeWithSeam({ handle });
  await waitReady(runtime);
  return runtime;
}

async function main(): Promise<void> {
  line(`HEAD=${process.env.SA6_HEAD ?? 'unknown'}`);
  const runtime = await makeRuntime(false);
  const rawRuntime = await makeRuntime(true);

  const headCall: CallFace = (p, o) => (o === undefined ? runtime.readData(p) : runtime.readData(p, o as never));
  const headRawCall: CallFace = (p, o) => (o === undefined ? rawRuntime.readData(p) : rawRuntime.readData(p, o as never));
  const gateCall: CallFace = (p, o) => (o === undefined ? runtime.readData(p) : withByteBudget(runtime, p, o));
  const gateRawCall: CallFace = (p, o) => (o === undefined ? rawRuntime.readData(p) : withByteBudget(rawRuntime, p, o));
  const strictOracle: CallFace = (p, o) => (o === undefined ? runtime.readData(p) : runtime.readData(p, o));
  const rawOracle: CallFace = (p, o) => (o === undefined ? rawRuntime.readData(p) : rawRuntime.readData(p, o));

  const groups: ReadonlyArray<{ label: string; checks: CheckResult[]; expectation: 'red' | 'green' }> = [
    { label: 'HEAD 真实 runtime（严格档）→ 期望目标断言红', checks: strictAssertions(headCall, strictOracle), expectation: 'red' },
    { label: 'HEAD 真实 runtime（raw 档）→ 期望目标断言红', checks: rawAssertions(headRawCall, rawOracle), expectation: 'red' },
    { label: '参考闸门（严格档；目标语义）→ 期望全绿', checks: strictAssertions(gateCall, strictOracle), expectation: 'green' },
    { label: '参考闸门（raw 档；目标语义）→ 期望全绿', checks: rawAssertions(gateRawCall, rawOracle), expectation: 'green' },
  ];
  for (const g of groups) {
    line();
    line(`--- ${g.label} ---`);
    for (const c of g.checks) line(`  [${c.ok ? 'PASS' : 'FAIL'}] ${c.name}\n        ${c.detail}`);
  }
  const headChecks = [...groups[0]!.checks, ...groups[1]!.checks];
  const gateChecks = [...groups[2]!.checks, ...groups[3]!.checks];
  line();
  line(
    `判读：HEAD 目标断言（期望全红）= 红 ${String(headChecks.filter((c) => !c.ok).length)}/${String(headChecks.length)}；` +
      `参考闸门（期望全绿）= 绿 ${String(gateChecks.filter((c) => c.ok).length)}/${String(gateChecks.length)}。`,
  );

  // ───────── L lease 透传 ─────────
  line();
  line('=== L registry lease 透传判据 ===');
  const registry = createNamespaceRegistryForTesting(new StubPersistence(new StubHandle(OWNER, 'ns-405', buildDoc(false))), {
    clock: manualClock(),
    scheduler: createRegistryTestScheduler(),
    randomBytes: deterministicRandomBytes,
  });
  const opened = await registry.open({ userId: OWNER.userId }, 'ns-405');
  if (!opened.ok) throw new Error(`装置前提失败：registry.open 应成功（${JSON.stringify(opened)}）`);
  const lease: NamespaceLease = opened.lease;
  const deadline = Date.now() + 5_000;
  while (!(lease.getStatus().lease === 'active' && lease.getStatus().runtime.schema.state === 'ready')) {
    if (Date.now() > deadline) throw new Error('装置前提失败：lease 未 ready');
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
  const leaseNoBudget = lease.readData([]);
  const mirror = runtime.readData([]);
  line(`L0 lease.readData([]) ≡ 同参直调 runtime.readData([])（无预算现状锚）：${String(eq(leaseNoBudget, mirror))}`);
  const leaseMaxBytes = lease.readData([], { maxBytes: 1 } as never);
  line(`L1 lease.readData([], {maxBytes:1}) @HEAD → ok=${String(leaseMaxBytes.ok)} code=${leaseMaxBytes.ok ? '-' : (leaseMaxBytes as { code: string }).code}（目标：READ_BUDGET_EXCEEDED measuredBytes=358）`);
  let releasedRead: AnyRead | undefined;
  await lease.release();
  try {
    releasedRead = lease.readData([], { maxBytes: 1 } as never);
  } catch {
    line('L2 released 短路：escaped throw（违反）');
  }
  line(`L2 released 短路优先于预算校验：code=${releasedRead?.ok === false ? (releasedRead as { code: string }).code : String(releasedRead?.ok)}`);

  // ───────── X 敌意 options 负控 ─────────
  line();
  line('=== X 敌意 options 负控（HEAD 与目标实现同判：响亮不抛、零 getter 执行、键空间纪律） ===');
  let getterCalls = 0;
  const accessor: Record<string, unknown> = {};
  Object.defineProperty(accessor, 'maxBytes', {
    get: () => {
      getterCalls += 1;
      return 1;
    },
    enumerable: true,
    configurable: true,
  });
  const x1 = runtime.readData([], accessor as never);
  line(`X1 accessor maxBytes → ok=${String(x1.ok)} code=${x1.ok ? '-' : (x1 as { code: string }).code} getterCalls=${String(getterCalls)}（目标：拒绝 + getter 零执行）`);
  let escaped = false;
  let x2: AnyRead | undefined;
  const stateful = new Proxy(
    { maxBytes: 1 },
    {
      getOwnPropertyDescriptor(target, key) {
        if (key === 'maxBytes') throw new Error('probe: descriptor trap');
        return Reflect.getOwnPropertyDescriptor(target, key);
      },
    },
  );
  try {
    x2 = runtime.readData([], stateful as never);
  } catch {
    escaped = true;
  }
  line(`X2 descriptor trap maxBytes → escapedThrow=${String(escaped)} ok=${String(x2?.ok)} code=${x2 === undefined || x2.ok ? '-' : (x2 as { code: string }).code}`);
  const hidden: Record<string, unknown> = {};
  Object.defineProperty(hidden, 'maxBytes', { value: 1, enumerable: false, configurable: true });
  const x3 = runtime.readData([], hidden as never);
  line(`X3 非 enumerable maxBytes（键空间外 ≡ 无预算）→ ok=${String(x3.ok)}${x3.ok ? '（成功；实现若用 `in`/直接属性读会误判为超限）' : ` code=${(x3 as { code: string }).code}`}`);

  process.stdout.write(out.join('\n') + '\n');
}

main().catch((error: unknown) => {
  process.stderr.write(`PROBE FAILED: ${String(error)}\n`);
  process.exitCode = 1;
});

