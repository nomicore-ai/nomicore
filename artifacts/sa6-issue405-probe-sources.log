/**
 * SA6 issue #405 临时行为探针（诊断用；**不是**测试文件——不入 vitest 收集、收尾删除）。
 *
 * 目的：
 *  P1 能力缺口：HEAD 上 `readData(path, { maxBytes })` 命中 options 未知键 → READ_OPTIONS_INVALID
 *     （无论预算大小），证明 maxBytes 收/拒闸在 HEAD 零落地。
 *  P2 两通道度量预言机：对若干读面输出 utf8(JSON.stringify(value)) + utf8(schema) 的精确字节数
 *     （供验收契约的边界锚：total / total-1 / total+1）。
 *  P3 回归指纹：无 maxBytes 面（无 options / depth / maxChildrenPerNode）的四键形状、头行、
 *     ✂ 段、交付字节哈希——成功面逐字节回归锚的现状基线。
 *  P4 负控：已知键 options 正常、生命周期失败面不变、PATH_NOT_ALLOWED 短路不变。
 *
 * 运行：NODE_OPTIONS=--conditions=nomicore-source pnpm exec tsx packages/namespace-runtime/.sa6-405-probe/probe-runtime.ts
 */
import { createHash } from 'node:crypto';
import * as Y from 'yjs';
import { createMemoryPersistence } from '@nomicore/persistence';
import type { PersistenceScheduler, User } from '@nomicore/persistence';
import { readLogicalValueAtPath } from '@nomicore/doc-runtime';
import { createNamespaceRuntimeWithSeam } from '../src/runtime.js';
import type {
  NamespaceRuntime,
  NamespaceRuntimeReadDataOptions,
  NamespaceRuntimeReadDataResult,
} from '../src/index.js';

const SCHEDULER: PersistenceScheduler = {
  setTimeout: (callback, delayMs) => globalThis.setTimeout(callback, delayMs),
  clearTimeout: (handle) => globalThis.clearTimeout(handle as ReturnType<typeof globalThis.setTimeout>),
};

/** 含 CJK 的 schema：使 utf8 字节数与 UTF-16 code unit 数**可区分**（反伪绿：度量单位敏感）。 */
const TXT_405 = `
type Meta = YMap<{
  /** 备注内容 */
  content: YLeaf<string>;
  /** 附加计数 */
  extra: YLeaf<number>;
}>;
type ROOT = YMap<{
  /** 页面标题 */
  title: YLeaf<string>;
  count: YLeaf<number>;
  /** 元数据 */
  meta: Meta;
  /** 标签组 */
  tags: YLeaf<string>[];
  /** 可选昵称 */
  nick?: YLeaf<string>;
}>;
`.trim();

const ENV_405 = { lang: 'vfsl', version: 1, id: 'ns-405', text: TXT_405 } as const;
const OWNER: User = { userId: 'u-405' };

function seedStrictRoot(root: Y.Map<unknown>): void {
  root.set('title', '你好，世界'); // 5 CJK/全角 chars → UTF-8 15B ≠ UTF-16 5
  root.set('count', 3);
  const meta = new Y.Map<unknown>();
  meta.set('content', '备注说明'); // 4 CJK chars → UTF-8 12B ≠ UTF-16 4
  meta.set('extra', 7);
  root.set('meta', meta);
  const tags = new Y.Array<string>();
  tags.push(['甲', '乙', '丙', '丁', '戊']);
  root.set('tags', tags);
  // 'nick'（optional）缺席：缺席目标 × 投影文本照常计量的锚
}

async function makeRuntime(opts: { raw?: boolean } = {}): Promise<{ runtime: NamespaceRuntime; doc: Y.Doc }> {
  const persistence = createMemoryPersistence({ scheduler: SCHEDULER });
  const doc = new Y.Doc();
  const sc = doc.getMap('SCHEMA');
  for (const [k, v] of Object.entries(ENV_405)) sc.set(k, v);
  const meta = doc.getMap('META');
  meta.set('docId', 'ns-405');
  meta.set('createdAt', 1_700_000_000_000);
  seedStrictRoot(doc.getMap('ROOT'));
  if (opts.raw === true) doc.getMap('ROOT').set('rogue', 'x'.repeat(100)); // schema 外数据：值通道单侧计量锚
  const handle = await persistence.createDoc(OWNER, 'ns-405', doc);
  const runtime = createNamespaceRuntimeWithSeam({ handle });
  const deadline = Date.now() + 5_000;
  while (runtime.getStatus().schema.state !== 'ready') {
    if (Date.now() > deadline) throw new Error('装置前提失败：schema 未在 5s 内 ready');
    await new Promise((resolve) => setTimeout(resolve, 10));
  }
  return { runtime, doc };
}

const utf8 = (text: string): number => Buffer.byteLength(text, 'utf8');
const utf16 = (text: string): number => text.length;

function sha(text: string): string {
  return createHash('sha256').update(text, 'utf8').digest('hex').slice(0, 16);
}

interface Delivered {
  readonly valueJson: string | undefined;
  readonly schema: string | null;
  readonly valueBytes: number;
  readonly schemaBytes: number;
  readonly total: number;
}

/** 规范度量（ADR 0031 §2）：值通道 utf8(JSON.stringify(value))（undefined 计 0）+ schema 通道 utf8(投影文本)（null 计 0）。 */
function measure(value: unknown, schema: string | null): Delivered {
  const valueJson = JSON.stringify(value);
  const valueBytes = valueJson === undefined ? 0 : utf8(valueJson);
  const schemaBytes = schema === null ? 0 : utf8(schema);
  return { valueJson, schema, valueBytes, schemaBytes, total: valueBytes + schemaBytes };
}

function okOrThrow(r: NamespaceRuntimeReadDataResult | { ok: true; value: unknown; schema: string | null; truncated: boolean }): {
  ok: true;
  value: unknown;
  schema: string | null;
  truncated: boolean;
} {
  if (r.ok !== true) throw new Error(`装置前提失败：期望 ok:true，实际 ${JSON.stringify(r)}`);
  return r;
}

const out: string[] = [];
const line = (s = ''): void => {
  out.push(s);
};

async function main(): Promise<void> {
  const { runtime, doc } = await makeRuntime();
  const runtimeKeys = Object.keys(runtime).sort();
  line(`HEAD=${process.env.SA6_HEAD ?? 'unknown'}`);
  line(`node=${process.version} keys=${JSON.stringify(runtimeKeys)}`);
  line(`schema.state=${runtime.getStatus().schema.state}`);
  line();

  // ───────── P1 能力缺口：maxBytes 在 HEAD 上 = 未知键 ─────────
  line('=== P1 能力缺口：readData(path, {maxBytes}) @HEAD（raw cast：类型面缺口见 probe-types.ts） ===');
  const maxBytesCases: ReadonlyArray<{ name: string; path: readonly (string | number)[]; options: object }> = [
    { name: 'A1 {maxBytes:1} 紧预算', path: [], options: { maxBytes: 1 } },
    { name: 'A2 {maxBytes:100000} 宽预算', path: [], options: { maxBytes: 100000 } },
    { name: 'A3 {maxBytes:0} 非法', path: [], options: { maxBytes: 0 } },
    { name: 'A4 {maxBytes:-1} 非法', path: [], options: { maxBytes: -1 } },
    { name: 'A5 {maxBytes:1.5} 非法', path: [], options: { maxBytes: 1.5 } },
    { name: 'A6 {maxBytes:NaN} 非法', path: [], options: { maxBytes: Number.NaN } },
    { name: 'A7 {maxBytes:Infinity} 非法', path: [], options: { maxBytes: Number.POSITIVE_INFINITY } },
    { name: "A8 {maxBytes:'100'} 非法", path: [], options: { maxBytes: '100' } },
    { name: 'A9 {maxBytes:undefined} 缺席语义', path: [], options: { maxBytes: undefined } },
    { name: 'A10 {unknownKey:1} 未知键（既有负控）', path: [], options: { unknownKey: 1 } },
    { name: 'A11 {maxBytes:1,depth:1} 混合', path: [], options: { maxBytes: 1, depth: 1 } },
    { name: 'A12 {depth:1} 已知键（正向负控）', path: [], options: { depth: 1 } },
    { name: 'A13 {maxChildrenPerNode:2} 已知键（正向负控）', path: [], options: { maxChildrenPerNode: 2 } },
  ];
  for (const c of maxBytesCases) {
    const r = runtime.readData(c.path, c.options as unknown as NamespaceRuntimeReadDataOptions);
    line(
      `${c.name} -> ok=${String(r.ok)} code=${r.ok ? '-' : (r as { code: string }).code} keys=${JSON.stringify(Object.keys(r))}` +
        (r.ok ? '' : ` message=${JSON.stringify((r as { message?: string }).message ?? '')}`),
    );
    if (!r.ok && (r as { code: string }).code === 'READ_BUDGET_EXCEEDED') {
      line(`   measuredBytes=${String((r as { measuredBytes: number }).measuredBytes)}`);
    }
  }
  line();

  // ───────── P2 两通道度量预言机（边界锚） ─────────
  line('=== P2 规范度量预言机（utf8 字节；供 ≤ 边界锚 total/total±1） ===');
  const reads: ReadonlyArray<{ name: string; path: readonly (string | number)[]; options?: NamespaceRuntimeReadDataOptions }> = [
    { name: 'R0 readData([]) 无 options', path: [] },
    { name: 'R1 readData([], {depth:1})', path: [], options: { depth: 1 } },
    { name: 'R2 readData([], {depth:0}) 折叠', path: [], options: { depth: 0 } },
    { name: 'R3 readData([], {maxChildrenPerNode:2}) width 截断', path: [], options: { maxChildrenPerNode: 2 } },
    { name: 'R4 readData([title]) 标量', path: ['title'] },
    { name: 'R5 readData([meta]) ref 容器', path: ['meta'] },
    { name: 'R6 readData([tags]) 数组', path: ['tags'] },
    { name: 'R7 readData([nick]) 缺席目标（schema 在场）', path: ['nick'] },
    { name: 'R8 readData([rogue]) 路径偏离（schema null）', path: ['rogue'] },
  ];
  for (const r of reads) {
    const result = r.options === undefined ? runtime.readData(r.path) : runtime.readData(r.path, r.options);
    if (!result.ok) {
      line(`${r.name} -> FAILURE code=${(result as { code: string }).code}`);
      continue;
    }
    const m = measure(result.value, result.schema);
    const valueChars = m.valueJson === undefined ? 0 : utf16(m.valueJson);
    const schemaChars = m.schema === null ? 0 : utf16(m.schema);
    line(
      `${r.name} -> truncated=${String(result.truncated)} keys=${JSON.stringify(Object.keys(result))}\n` +
        `    valueBytes=${String(m.valueBytes)} schemaBytes=${String(m.schemaBytes)} TOTAL=${String(m.total)}` +
        ` | utf16 对照 valueChars=${String(valueChars)} schemaChars=${String(schemaChars)}` +
        ` | utf8≠utf16? value:${String(m.valueBytes !== valueChars)} schema:${String(m.schemaBytes !== schemaChars)}\n` +
        `    head=${JSON.stringify(m.schema === null ? null : m.schema.split('\n')[0])} schema_null=${String(m.schema === null)}` +
        ` value_undefined=${String(result.value === undefined)} value_key_present=${String('value' in result)}\n` +
        `    sha16(valueJson)=${m.valueJson === undefined ? '-' : sha(m.valueJson)} sha16(schema)=${m.schema === null ? '-' : sha(m.schema)}` +
        ` ✂included=${String(m.schema !== null && m.schema.includes('✂ 截断事实：'))}`,
    );
    line(`    schema_tail=${JSON.stringify(m.schema === null ? null : m.schema.slice(-96))}`);
  }
  line();

  // ───────── P3 成功面逐字节回归锚（现值指纹） ─────────
  line('=== P3 无 maxBytes 成功面指纹（回归锚：实现后须逐字节不变） ===');
  const r0 = okOrThrow(runtime.readData([]));
  const r0b = okOrThrow(runtime.readData([]));
  const r1 = okOrThrow(runtime.readData([], { depth: 1 }));
  const r1b = okOrThrow(runtime.readData([], { depth: 1 }));
  const m0 = measure(r0.value, r0.schema);
  const m1 = measure(r1.value, r1.schema);
  line(`same-args determinism: R0 vs R0' -> ${String(m0.valueBytes === measure(r0b.value, r0b.schema).valueBytes && m0.schema === r0b.schema)}`);
  line(`same-args determinism: R1 vs R1' -> ${String(m1.valueBytes === measure(r1b.value, r1b.schema).valueBytes && m1.schema === r1b.schema)}`);
  line(`R0 keys=${JSON.stringify(Object.keys(r0))} schema_is_string=${String(typeof r0.schema === 'string')}`);
  line(`R1 keys=${JSON.stringify(Object.keys(r1))} truncated=${String(r1.truncated)} ✂=${String(r1.schema !== null && r1.schema.includes('✂'))} head=${JSON.stringify(r1.schema?.split('\n')[0] ?? null)}`);
  line();

  // ───────── P4 负控：既有失败面/生命周期不变 ─────────
  line('=== P4 负控（HEAD 必须绿） ===');
  const pathNotAllowed = runtime.readData(['title', 0]);
  line(`N1 readData([title,0]) 载体不匹配 -> ok=${String(pathNotAllowed.ok)} code=${pathNotAllowed.ok ? '-' : (pathNotAllowed as { code: string }).code}`);
  const offSchema = runtime.readData(['rogue']);
  line(`N2 readData([rogue]) 路径偏离 -> ok=${String(offSchema.ok)} schema_null=${String(offSchema.ok && offSchema.schema === null)} value_undefined=${String(offSchema.ok && offSchema.value === undefined)}`);
  const protoOptions = Object.create({ depth: 1 }) as object;
  const protoRead = runtime.readData([], protoOptions as NamespaceRuntimeReadDataOptions);
  line(`N3 继承键 options（{__proto__:{depth:1}}）-> ok=${String(protoRead.ok)} (canonical 等价面无预算段：${String(protoRead.ok && protoRead.schema?.split('\n')[0] === '# readData []')})`);
  const nonEnumerable = {};
  Object.defineProperty(nonEnumerable, 'maxBytes', { value: 1, enumerable: false, configurable: true });
  const nonEnumRead = runtime.readData([], nonEnumerable as NamespaceRuntimeReadDataOptions);
  line(`N4 非 enumerable maxBytes 键 -> ok=${String(nonEnumRead.ok)} code=${nonEnumRead.ok ? '-' : (nonEnumRead as { code: string }).code}`);
  const accessor = {};
  Object.defineProperty(accessor, 'maxBytes', { get: () => 1, enumerable: true, configurable: true });
  const accessorRead = runtime.readData([], accessor as NamespaceRuntimeReadDataOptions);
  line(`N5 accessor maxBytes 键（零 getter 执行）-> ok=${String(accessorRead.ok)} code=${accessorRead.ok ? '-' : (accessorRead as { code: string }).code}`);
  line();

  // ───────── P5 raw 变体：schema null 单侧计量 + 双轴 ✂ 面 ─────────
  line('=== P5 raw 变体（schema 外数据：仅值侧计量）与双轴面 ===');
  const { runtime: rawRuntime } = await makeRuntime({ raw: true });
  const rawRead = rawRuntime.readData(['rogue']);
  if (rawRead.ok) {
    const m = measure(rawRead.value, rawRead.schema);
    line(
      `R9 readData([rogue]) raw 值（schema null） -> schema_null=${String(rawRead.schema === null)} value_undefined=${String(rawRead.value === undefined)}` +
        ` valueBytes=${String(m.valueBytes)} schemaBytes=${String(m.schemaBytes)} TOTAL=${String(m.total)}`,
    );
  }
  const rawRoot = rawRuntime.readData([]);
  if (rawRoot.ok) {
    const m = measure(rawRoot.value, rawRoot.schema);
    line(`R10 readData([]) raw ROOT -> valueBytes=${String(m.valueBytes)} schemaBytes=${String(m.schemaBytes)} TOTAL=${String(m.total)}`);
  }
  const both = runtime.readData([], { depth: 1, maxChildrenPerNode: 2 });
  if (both.ok) {
    const m = measure(both.value, both.schema);
    line(
      `R11 readData([], {depth:1,maxChildrenPerNode:2}) -> truncated=${String(both.truncated)} valueBytes=${String(m.valueBytes)} schemaBytes=${String(m.schemaBytes)} TOTAL=${String(m.total)}` +
        ` head=${JSON.stringify(m.schema?.split('\n')[0] ?? null)} ✂=${String(m.schema !== null && m.schema.includes('✂ 截断事实：'))}`,
    );
  }
  const emptyBudget = runtime.readData([], {});
  if (emptyBudget.ok) {
    const m = measure(emptyBudget.value, emptyBudget.schema);
    line(
      `R12 readData([], {}) 空预算 options -> TOTAL=${String(m.total)} head=${JSON.stringify(m.schema?.split('\n')[0] ?? null)}` +
        ` (空预算 ≡ 无预算段；ADR 0031 收/拒参数不塑形头行)`,
    );
  }

  // ───────── P6 规模/成本：闸门测量 = 一次序列化遍历（O(交付字节)） ─────────
  line();
  line('=== P6 规模/成本基线（large 值通道；仅诊断，无阈值断言） ===');
  const bigRoot = doc.getMap('ROOT');
  const big = new Y.Array<number>();
  const N = 50_000;
  big.push(Array.from({ length: N }, (_, i) => i % 997));
  bigRoot.set('big', big); // schema 外路径（['big'] → schema null），值侧单通道
  const bigRead = runtime.readData(['big']);
  if (bigRead.ok) {
    const json = JSON.stringify(bigRead.value);
    const valueBytes = json === undefined ? 0 : utf8(json);
    const t0 = performance.now();
    const r1 = runtime.readData(['big']);
    const t1 = performance.now();
    if (r1.ok) {
      const j = JSON.stringify(r1.value);
      const t2 = performance.now();
      const bytes = j === undefined ? 0 : utf8(j);
      const t3 = performance.now();
      line(`P6 big(n=${String(N)}) valueBytes=${String(valueBytes)} schema_null=${String(bigRead.schema === null)}`);
      line(`P6 t(readData)=${(t1 - t0).toFixed(2)}ms  t(JSON.stringify+utf8)≈${(t3 - t2).toFixed(2)}ms  （闸门测量 = 交付后一次序列化遍历）`);
    }
  }

  // ───────── P7 窗口面边界（本票 tracer 只治 readData 面） ─────────
  line();
  line('=== P7 窗口面边界（tracer 范围：readData 面；窗口面本票不动） ===');
  const arrMax = runtime.readArray(['tags'], { n: 1, maxBytes: 1 } as never);
  line(`P7a readArray([tags], {n:1,maxBytes:1}) → ok=${String(arrMax.ok)} code=${arrMax.ok ? '-' : (arrMax as { code: string }).code}`);
  const mapMax = runtime.readMap(['meta'], { n: 1, maxBytes: 1 } as never);
  line(`P7b readMap([meta], {n:1,maxBytes:1}) → ok=${String(mapMax.ok)} code=${mapMax.ok ? '-' : (mapMax as { code: string }).code}`);
  const noBudgetArr = runtime.readArray(['tags'], { n: 1 });
  line(`P7c readArray([tags], {n:1}) 无预算现状锚 → ok=${String(noBudgetArr.ok)} keys=${JSON.stringify(Object.keys(noBudgetArr))}`);

  // ───────── P8 doc-runtime 边界（ADR 0031 §4：doc-runtime 零改动、下传两键） ─────────
  line();
  line('=== P8 doc-runtime 边界（零改动锚：maxBytes 不进 doc-runtime 校验域） ===');
  const docRead = readLogicalValueAtPath(doc, ['title'], { maxBytes: 1 } as never);
  line(`P8a docRuntime.readLogicalValueAtPath(doc,[title],{maxBytes:1}) → ok=${String(docRead.ok)} code=${docRead.ok ? '-' : (docRead as { code: string }).code}`);
  const docRead2 = readLogicalValueAtPath(doc, ['title'], { depth: 1 });
  line(`P8b docRuntime.readLogicalValueAtPath(doc,[title],{depth:1}) → ok=${String(docRead2.ok)} keys=${JSON.stringify(Object.keys(docRead2))}`);

  // ───────── P9 lifecycle 优先（含 maxBytes 的 options 在 closing/closed 期零读取） ─────────
  line();
  line('=== P9 lifecycle gate 优先于 options 读取与预算判定 ===');
  let trapCalls = 0;
  const trapOptions = new Proxy(
    { maxBytes: 1 },
    {
      get(t, k, r) {
        trapCalls += 1;
        return Reflect.get(t, k, r);
      },
      getOwnPropertyDescriptor(t, k) {
        trapCalls += 1;
        return Reflect.getOwnPropertyDescriptor(t, k);
      },
      ownKeys(t) {
        trapCalls += 1;
        return Reflect.ownKeys(t);
      },
      has(t, k) {
        trapCalls += 1;
        return Reflect.has(t, k);
      },
    },
  );
  await runtime.close();
  const closedRead = runtime.readData([], trapOptions as never);
  line(`P9 closed 期 readData([], Proxy{maxBytes}) → ok=${String(closedRead.ok)} code=${closedRead.ok ? '-' : (closedRead as { code: string }).code} trapCalls=${String(trapCalls)}`);

  process.stdout.write(out.join('\n') + '\n');
}

main().catch((error: unknown) => {
  process.stderr.write(`PROBE FAILED: ${String(error)}\n`);
  process.exitCode = 1;
});

